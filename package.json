{
  "name": "piquet-vendor",
  "main": "expo-router/entry",
  "version": "1.0.18",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "ios": "expo run:ios  --device",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && jest --ci",
    "lint": "expo lint",
    "build-local:android": "npx expo prebuild && cd android && ./gradlew assembleRelease && cd app/build/outputs/apk/release && open .",
    "build-local:ios:production": "APP_ENV=production yarn prebuild:ios",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "eas-build-preview:ios": "eas build --platform ios --profile preview",
    "eas-build-preview:android": "eas build --platform android_old --profile preview",
    "update:production": "APP_ENV=production eas update --channel production --auto",
    "update:staging": "APP_ENV=staging eas update --channel staging --auto",
    "update:preview": "APP_ENV=preview eas update --channel preview --auto"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.2.3",
    "@expo/config-plugins": "~9.0.0",
    "@expo/prebuild-config": "^8.0.25",
    "@expo/react-native-action-sheet": "^4.1.0",
    "@expo/vector-icons": "^14.0.2",
    "@gorhom/bottom-sheet": "^5.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.9.0",
    "@react-navigation/native": "^7.0.0",
    "advanced-html-parser": "^1.1.0",
    "axios": "^1.16.0",
    "core-js": "^3.39.0",
    "expo": "~52.0.38",
    "expo-application": "~6.0.2",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.14",
    "expo-device": "~7.0.1",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.4",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-localization": "~16.0.1",
    "expo-location": "~18.0.8",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.19",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.8",
    "expo-task-manager": "~12.0.5",
    "expo-updates": "~0.27.5",
    "expo-web-browser": "~14.0.2",
    "i18next": "^24.2.3",
    "iban": "^0.0.14",
    "jwt-decode": "^4.0.0",
    "laravel-echo": "^1.16.1",
    "nativewind": "^2.0.11",
    "pusher-js": "^8.4.0-rc2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.4.1",
    "react-native": "0.76.9",
    "react-native-background-timer": "^2.4.1",
    "react-native-click-outside": "0.1.1",
    "react-native-currency-input": "^1.1.1",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-keep-awake": "^4.0.0",
    "react-native-keyboard-controller": "^1.17.1",
    "react-native-map-link": "^3.9.0",
    "react-native-maps": "1.18.0",
    "react-native-modal": "^13.0.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-otp-entry": "^1.8.4",
    "react-native-reanimated": "~3.16.1",
    "react-native-rsa-native": "^2.0.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.10",
    "use-debounce": "^10.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@klarr-agency/circum-icons-react": "^2.0.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/babel__core": "^7.20.5",
    "@types/iban": "^0.0.35",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-native-background-timer": "^2.0.2",
    "@types/react-test-renderer": "^18.0.7",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.6",
    "patch-package": "^8.0.1",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "3.3.2",
    "typescript": "~5.3.3"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "overrides": {
    "form-data": ">=4.0.6",
    "axios": "$axios"
  }
}
