{
  "name": "piquet-vendor",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "ios": "expo run:ios  --device",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && jest --ci",
    "lint": "expo lint",
    "build-local:android": "npx expo prebuild && cd android && ./gradlew assembleRelease && cd app/build/outputs/apk/release && open .",
    "build-local:ios:production": "APP_ENV=production yarn prebuild:ios",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "eas-build-preview:ios": "eas build --platform ios --profile preview",
    "eas-build-preview:android": "eas build --platform android_old --profile preview",
    "update:production": "APP_ENV=production eas update --channel production --auto",
    "update:staging": "APP_ENV=staging eas update --channel staging --auto",
    "update:preview": "APP_ENV=preview eas update --channel preview --auto"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.2.3",
    "@expo/react-native-action-sheet": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.0.0",
    "advanced-html-parser": "^1.1.0",
    "axios": "^1.16.0",
    "babel-preset-expo": "~54.0.10",
    "core-js": "^3.39.0",
    "expo": "^54.0.0",
    "expo-application": "~7.0.8",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "i18next": "^24.2.3",
    "iban": "^0.0.14",
    "jwt-decode": "^4.0.0",
    "laravel-echo": "^1.16.1",
    "nativewind": "^4.2.7",
    "pusher-js": "^8.4.0-rc2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.4.1",
    "react-native": "0.81.5",
    "react-native-background-timer": "^2.4.1",
    "react-native-click-outside": "0.1.1",
    "react-native-currency-input": "^1.1.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keep-awake": "^4.0.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-map-link": "^3.9.0",
    "react-native-maps": "1.20.1",
    "react-native-modal": "^13.0.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-otp-entry": "^1.8.4",
    "react-native-reanimated": "~3.19.5",
    "react-native-rsa-native": "^2.0.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "use-debounce": "^10.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/babel__core": "^7.20.5",
    "@types/iban": "^0.0.35",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "@types/react-native-background-timer": "^2.0.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "overrides": {
    "form-data": ">=4.0.6",
    "axios": "$axios"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  }
}
